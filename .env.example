# Copy to .env (never commit .env). All values optional — the server runs without them.

# Companies House public API key (free): register at
# https://developer.company-information.service.gov.uk
# Without it, the lookup_company tool returns a clear "not configured" error.
COMPANIES_HOUSE_API_KEY=

# Override the "Apply with iwoca" link (defaults to https://www.iwoca.co.uk/apply/new)
# IWOCA_APPLICATION_URL=

# Server basics
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
