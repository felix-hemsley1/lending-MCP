{
  "name": "iwoca-chatgpt-mcp",
  "version": "0.1.0",
  "description": "Proof of concept MCP server exposing read-only iwoca product info, a loan repayment estimator, and the illustrative iwoca Credit Compass for use from ChatGPT or a Claude connector.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/server.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/stdio.js",
    "preview": "npx --yes serve . -l 4321",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
